# Vynix Hosting Panel Environment Configuration
# Copy to .env and fill with real values. Never commit real secrets.

NODE_ENV=production
PANEL_PORT=6580
PANEL_BIND=0.0.0.0
DATABASE_URL=sqlite:./data/vynix.db
SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
ACCESS_MODE=port
ACCESS_CONFIG=0.0.0.0

# Optional: Node agent connection (for multi-node Docker management)
# NODE_AGENT_TOKEN=your-secure-token-here
# NODE_AGENT_HOST=127.0.0.1
# NODE_AGENT_PORT=6581

# Optional: SMTP for password reset / notifications
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
